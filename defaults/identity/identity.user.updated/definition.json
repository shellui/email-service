      "is_url": false
    },
    {
      "token": "recipient_email",
      "type": "string",
      "required": false,
      "description": "email.var.recipient_email",
      "example": "ada@acme.com",
      "is_url": false
    },
    {
      "token": "changed_fields",
      "type": "string",
      "required": false,
      "description": "email.var.changed_fields",
      "example": "displayName",
      "is_url": false
    }
  ]
}
