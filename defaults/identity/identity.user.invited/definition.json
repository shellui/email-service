{
  "key": "identity.user.invited",
  "owner_service": "identity",
  "lane_class": "auth",
  "default_lane": "auth",
  "category": "auth",
  "default_enabled": true,
  "default_ttl_seconds": 300,
  "variables": [
    {
      "token": "company_name",
      "type": "string",
      "required": true,
      "description": "email.var.company_name",
      "example": "Acme",
      "is_url": false
    },
    {
      "token": "inviter_name",
      "type": "string",
      "required": false,
      "description": "email.var.inviter_name",
      "example": "Grace",
      "is_url": false
    },
    {
      "token": "invitation_url",
      "type": "url",
      "required": true,
      "description": "email.var.invitation_url",
      "example": "https://app.acme.com/",
      "is_url": true
    },
    {
      "token": "recipient_email",
      "type": "string",
      "required": false,
      "description": "email.var.recipient_email",
      "example": "ada@acme.com",
      "is_url": false
    }
  ]
}
