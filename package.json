{
  "name": "email-service-frontend",
  "private": true,
  "description": "Tailwind CSS build for email-service pages and the React Email composer",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/css/input.css -o ./static/css/site.css --minify",
    "watch:css": "tailwindcss -i ./assets/css/input.css -o ./static/css/site.css --watch",
    "dev:css": "npm run watch:css",
    "import:demos": "node tools/import-demos.mjs"
  },
  "dependencies": {
    "@react-email/editor": "1.7.3",
    "@react-email/render": "2.1.0",
    "happy-dom": "20.14.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-email": "6.9.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "0.28.2",
    "tailwindcss": "^4.3.3"
  }
}
