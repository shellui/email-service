# email-service settings. Full reference: docs/configuration.md
# Generated from config/env_registry.py: python manage.py generate_env --example > .env.example
# Production: python manage.py generate_env --host email.example.com
# Copy to .env for local runs. Commented-out lines show the default the code uses.

# Required
# Signs sessions and CSRF tokens. Required to start. 50+ characters when DEBUG=false.
SECRET_KEY=
# Local development only. Unset means false (production).
DEBUG=true
# Local identity-service. JWKS is fetched from {url}/.well-known/jwks.json in DEBUG.
IDENTITY_SERVICE_URL=http://localhost:8000
# Local dev: allow-all CORS. Unset in production (defaults to false).
CORS_ALLOW_ALL_ORIGINS=true

# Required when DEBUG=false (production). With DEBUG=true the mail keys derive from SECRET_KEY.
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
PUBLIC_BASE_URL=
IDENTITY_ISSUER=
IDENTITY_AUDIENCE=
IDENTITY_JWKS=
POSTGRES_DATABASE_URL=
REDIS_URL=
EMAIL_CREDENTIALS_KEY=
EMAIL_VARIABLES_KEY=
EMAIL_HASH_PEPPER=

# Optional (defaults shown)

# Runtime
# LOG_LEVEL=INFO
# SETUP_TOKEN=
# DJANGO_ADMIN_ENABLED=true
# EMAIL_SERVICE_PORT=8003

# Database: SQLite (local only) unless POSTGRES_DATABASE_URL is set
# SQLITE_PATH=db.sqlite3
# POSTGRES_SSL_REQUIRE=true
# IDENTITY_JWKS_FILE=
# IDENTITY_JWKS_URL=
# JWKS_CACHE_TTL=900
# JWKS_TIMEOUT=15
# JWKS_RETRIES=2
# JWT_ALGORITHMS=RS256
# JWT_HS256_FALLBACK_SECRET=
# ALLOW_JWT_HS256_FALLBACK=false

# Addresses and links (EMAIL_PUBLIC_URL defaults to PUBLIC_BASE_URL)
# EMAIL_PUBLIC_URL=
# DEFAULT_FROM_EMAIL=no-reply@shellui.com
# DEFAULT_FROM_NAME=Shellui
# BULK_FROM_EMAIL=news@news.shellui.com
# BULK_FROM_NAME=Shellui
# EMAIL_AUTH_LINK_HOSTS=id.shellui.com
# EMAIL_AUTH_DEFAULT_TTL_SECONDS=120
# EMAIL_AUTH_MAX_TTL_SECONDS=300

# Provider fallback (off by default: resend, ses, smtp, or none)
# EMAIL_FALLBACK_PROVIDER=none
# RESEND_API_KEY=
# EMAIL_PLATFORM_COMPANY_IDS=
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=
# SES_REGION=eu-central-2
# SES_CONFIGURATION_SET=
# EMAIL_FALLBACK_COMPANY_DAILY_LIMIT=50
# EMAIL_FALLBACK_GLOBAL_DAILY_LIMIT=500
# EMAIL_FALLBACK_RECIPIENT_HOURLY_LIMIT=5
# EMAIL_ALLOW_COMPANY_SMTP=false
# EMAIL_ALLOW_FAKE_PROVIDER=false
# RESEND_WEBHOOK_SECRET=
# EMAIL_RESEND_BROADCAST_RPS=4
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_SMTP_VERIFY_CERT=true

# Rate limits and retention
# EMAIL_MESSAGE_RETENTION_DAYS=30
# EMAIL_IDEMPOTENCY_HOURS=24
# EMAIL_COMPANY_TRANSACTIONAL_PER_HOUR=1000
# EMAIL_RECIPIENT_AUTH_LIMIT=5
# EMAIL_RECIPIENT_AUTH_WINDOW_SECONDS=600
# EMAIL_COMPANY_AUTH_LIMIT=30
# EMAIL_COMPANY_AUTH_WINDOW_SECONDS=60
# EMAIL_CLIENT_IP_HEADER=
# EMAIL_CLIENT_IP_TRUSTED_PROXIES=1
# EVENT_LOG_RETENTION_DAYS=7

# Limits
# EMAIL_MAX_RECIPIENTS=50
# EMAIL_MAX_BATCH_ITEMS=500
# EMAIL_MAX_DOCUMENT_BYTES=524288
# EMAIL_MAX_VARIABLES_BYTES=8192

# Broadcasts
# EMAIL_BROADCAST_MAX_RECIPIENTS=10000
# EMAIL_BROADCAST_STEP_SECONDS=20

# Newsletters
# EMAIL_NEWSLETTER_IP_PER_HOUR=10
# EMAIL_NEWSLETTER_ADDRESS_PER_DAY=3
# EMAIL_NEWSLETTER_LIST_PER_HOUR=500
# EMAIL_NEWSLETTER_CONFIRM_HOURS=48
# EMAIL_NEWSLETTER_PENDING_DAYS=7
# EMAIL_NEWSLETTER_RESEND_MINUTES=10
# EMAIL_TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Composing
# EMAIL_NODE_BINARY=node
# EMAIL_COMPOSE_TIMEOUT_SECONDS=60

# Delivery and scheduled jobs
# EMAIL_DELIVER_SYNC=false
# EMAIL_SEND_LEASE_SECONDS=120
# EMAIL_WORKERS_ENABLED=true
# SCHEDULER_ENABLED=true
# CELERY_BROKER_URL=
# CELERY_WORKER_CONCURRENCY=2
# CELERY_BEAT_SCHEDULE_FILE=/tmp/celerybeat-schedule

# Shellui Actions (webhooks)
# ACTIONS_OUTBOX_MAX_ATTEMPTS=8
# ACTIONS_WEBHOOK_TIMEOUT_SECONDS=5
# ACTIONS_WEBHOOK_RETRY_LEASE_SECONDS=120
# ACTIONS_WEBHOOK_SYNC_DELIVERY=false
# ACTIONS_WEBHOOK_ALLOW_PRIVATE=false
# CORS_ALLOW_CREDENTIALS=false
# CORS_ALLOWED_ORIGINS=
# CORS_ALLOW_PRIVATE_NETWORK=true
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=false
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true

# Public pages
# SHELLUI_WEBSITE_URL=https://shellui.com
# SHELLUI_DOCS_URL=https://docs.shellui.com
# SHELLUI_PLAYGROUND_URL=https://playground.shellui.com
# SHELLUI_EMAIL_DOCS_URL=https://docs.shellui.com/email
# SHELLUI_IDENTITY_DOCS_URL=https://docs.shellui.com/identity
# SHELLUI_GITHUB_EMAIL_URL=https://github.com/shellui/email-service

# Error reporting
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0

# Gunicorn (Docker entrypoint)
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=2
# GUNICORN_TIMEOUT=120
