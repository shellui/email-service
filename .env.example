# App runtime
# Required. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
EMAIL_SERVICE_PORT=8003
DEBUG=true
# One-time web bootstrap token for creating the first superuser when DEBUG=false.
# Leave empty and use `uv run python manage.py createsuperuser` in production.
SETUP_TOKEN=
LOG_LEVEL=DEBUG
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
POSTGRES_DATABASE_URL=
# Require TLS for Postgres when DEBUG=false (default). Set false only for an internal database.
POSTGRES_SSL_REQUIRE=
# Shared cache. Required when DEBUG=false (rate limits).
# REDIS_URL=redis://127.0.0.1:6379/0
SECURE_SSL_REDIRECT=
SECURE_HSTS_SECONDS=
SESSION_COOKIE_SECURE=
CSRF_COOKIE_SECURE=
# This example turns CORS allow-all on for local use. Leave the variable unset in
# production: when DEBUG=false the service defaults to false.
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOWED_ORIGINS=http://localhost:4000,http://localhost:5174,http://localhost:5175,https://admin.shellui.com

# ---------------------------------------------------------------------------
# Identity JWKS. Public keys used to verify admin JWTs (not a private key).
# Production: pin keys locally (no runtime HTTP to identity):
#   IDENTITY_JWKS_FILE=/app/data/jwks.json
#   IDENTITY_JWKS={"keys":[...]}
# ---------------------------------------------------------------------------
IDENTITY_SERVICE_URL=http://localhost:8000
IDENTITY_JWKS_URL=
IDENTITY_JWKS_FILE=
IDENTITY_JWKS=
IDENTITY_ISSUER=
IDENTITY_AUDIENCE=
JWKS_CACHE_TTL=900
JWKS_TIMEOUT=15
JWKS_RETRIES=2
JWT_HS256_FALLBACK_SECRET=
JWT_ALGORITHMS=RS256

# Public site
PUBLIC_BASE_URL=https://email.shellui.com
DJANGO_ADMIN_ENABLED=true

# Renderer: python (block HTML, no Node) or node (React Email in renderer/render.mjs).
# The Docker image sets node. Local tests use python.
EMAIL_RENDERER=python
# Deliver inside the request process. Leave false in production and run workers.
EMAIL_DELIVER_SYNC=false

# Sending domains
# Auth and transactional mail: no-reply@shellui.com
# Bulk mail (later): news@news.shellui.com
# The HTTP service is email.shellui.com and does not send mail from that host.
DEFAULT_FROM_EMAIL=no-reply@shellui.com
DEFAULT_FROM_NAME=Shellui
BULK_FROM_EMAIL=news@news.shellui.com
BULK_FROM_NAME=Shellui

# Platform fallback provider. Used for Shellui's own mail (EMAIL_PLATFORM_COMPANY_IDS)
# and for identity auth mail when a company has no provider. Other lanes then
# return platform_sender_not_allowed. Set to none to disable the fallback.
EMAIL_FALLBACK_PROVIDER=resend
# Comma-separated company ids that may send from the platform From address.
EMAIL_PLATFORM_COMPANY_IDS=
# Company SMTP is off until set true. When true, the host must be a public address.
EMAIL_ALLOW_COMPANY_SMTP=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

# Required when DEBUG=false. Fernet keys:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_CREDENTIALS_KEY=
EMAIL_VARIABLES_KEY=
EMAIL_HASH_PEPPER=

# Hosts allowed in auth-template URL variables (magic links).
# When DEBUG=false, localhost and 127.0.0.1 are removed even if listed here.
EMAIL_AUTH_LINK_HOSTS=id.shellui.com,localhost,127.0.0.1
EMAIL_AUTH_DEFAULT_TTL_SECONDS=120
EMAIL_AUTH_MAX_TTL_SECONDS=300
EMAIL_MESSAGE_RETENTION_DAYS=30
EMAIL_IDEMPOTENCY_HOURS=24
EMAIL_COMPANY_TRANSACTIONAL_PER_HOUR=1000
EMAIL_RECIPIENT_AUTH_LIMIT=5
EMAIL_RECIPIENT_AUTH_WINDOW_SECONDS=600
EMAIL_COMPANY_AUTH_LIMIT=30
EMAIL_COMPANY_AUTH_WINDOW_SECONDS=60

# Shellui Actions (outbound webhooks)
# ACTIONS_WEBHOOK_TIMEOUT_SECONDS=5
# ACTIONS_OUTBOX_MAX_ATTEMPTS=8
# ACTIONS_WEBHOOK_ALLOW_PRIVATE=false
# ACTIONS_WEBHOOK_SYNC_DELIVERY=false
# EVENT_LOG_RETENTION_DAYS=7

# Sentry (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
